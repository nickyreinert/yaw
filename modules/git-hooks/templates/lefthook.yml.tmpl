# lefthook.yml (git-hooks module, ADR-0026). Install the git hook once with `just hooks-install`.
# Reference: https://lefthook.dev/configuration/
pre-commit:
  parallel: false
  jobs:
    # First: a commit with a secret must not get any further.
    - name: secrets
      run: |
        if command -v gitleaks >/dev/null 2>&1; then
          gitleaks git --pre-commit --staged --redact --no-banner
        else
          echo "git-hooks: gitleaks is not installed, so the staged changes were NOT scanned for secrets (brew install gitleaks)" >&2
        fi
    - name: format
      run: just fmt
      stage_fixed: true
    - name: lint
      run: just lint
<% if codeMapModule %>
    # Cheap check on the working tree: the code map must match the project structure (code-map module, ADR-0033).
    - name: code-map
      run: just map-check
<% end %>
<% if prePush %>
pre-push:
  jobs:
<% if teamModule %>
    # Team mode (team module, ADR-0031): nobody pushes to the default branch. A script, not `run`: lefthook
    # skips `run` jobs on pre-push when the push brings no new files, a script always runs.
    - name: no-push-to-default-branch
      script: yaw-default-branch.sh
      runner: sh
      use_stdin: true
<% end %>
<% if review.anyPush %>
    # Push gate (review module, ADR-0055): the required reviewers check the commits being pushed.
    - name: review-gate
      script: yaw-review.sh
      runner: sh
      use_stdin: true
<% end %>
<% end %>
