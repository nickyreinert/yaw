{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "profile.yaml",
  "description": "Stack profile definition (doc 05 §2).",
  "type": "object",
  "required": ["name", "title", "summary", "stack"],
  "properties": {
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "title": { "description": "Short name shown in the setup, e.g. FastAPI web app.", "type": "string", "minLength": 1, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 1 },
    "stack": {
      "description": "The language x runs-on pairs this profile is picked for (ADR-0054). Every pair belongs to at most one profile; basic profiles cover the pairs no tailored profile has.",
      "type": "object",
      "required": ["language", "runsOn"],
      "properties": {
        "language": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/language" }, "minItems": 1, "uniqueItems": true },
        "runsOn": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/runsOn" }, "minItems": 1, "uniqueItems": true },
        "notes": {
          "description": "Hosting-specific guidance and limits shown in CLI and browser setup.",
          "type": "object",
          "patternProperties": { "^(local|self-hosted|serverless|edge|static|wordpress|app-store|browser-extension)$": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "basic": { "description": "Standard language tools only, no framework or host setup.", "type": "boolean" }
      },
      "additionalProperties": false
    },
    "options": {
      "description": "Forks inside one profile (ADR-0105), asked as arch.<profile>-<option>. The default must be one of the choices; scaffold: true selects variants/<choice>/ (at most one option).",
      "type": "object",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*$": {
          "type": "object",
          "required": ["choices", "default"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "hint": { "type": "string", "minLength": 1 },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  { "type": ["string", "number", "boolean"] },
                  {
                    "type": "object",
                    "required": ["value"],
                    "properties": {
                      "value": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "label": { "type": "string", "minLength": 1 },
                      "note": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "default": { "type": ["string", "number", "boolean"] },
            "scaffold": { "description": "The choice selects the scaffold variant profiles/<p>/variants/<choice>/.", "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "modules": {
          "description": "Module preselection by this profile; auto = decided by the module's appliesTo and default rules.",
          "type": "object",
          "patternProperties": { "^[a-z][a-z0-9-]*$": { "enum": [true, false, "auto"] } },
          "additionalProperties": false
        },
        "budgets": {
          "type": "object",
          "patternProperties": { "^[a-z][a-zA-Z0-9]*$": { "type": "number", "minimum": 0 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "description": "Tools that must be installed, optionally with a minimum version (node>=22.13).",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(>=[0-9]+(\\.[0-9]+)*)?$" },
      "uniqueItems": true
    },
    "tools": {
      "description": "Third-party tools the stack needs beyond requires (T-004, ADR-0116): shown when the profile is picked and, if the check fails, at the end of yaw init. when limits a tool to one option choice.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "check", "install"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "check": { "description": "Shell command that exits 0 when the tool is installed.", "type": "string", "minLength": 1 },
          "install": {
            "description": "Copy-paste install command per platform.",
            "type": "object",
            "required": ["macos", "linux"],
            "properties": { "macos": { "type": "string", "minLength": 1 }, "linux": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          },
          "when": { "description": "{ option: choice } of this profile.", "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "dependencyEcosystems": {
      "description": "Dependabot ecosystems for dependencies in this profile's scaffold, including development/test dependencies; omit for dependency-free profiles.",
      "type": "array",
      "items": { "enum": ["npm", "pip", "composer", "gradle", "swift", "cargo", "gomod"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
