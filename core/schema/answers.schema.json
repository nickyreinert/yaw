{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answers.schema.json",
  "title": ".yaw/answers.yaml",
  "description": "Interview answers of a project (doc 02, doc 03). Never holds secrets: no question can ask for one and secret-like keys are rejected.",
  "type": "object",
  "required": ["mode", "answers"],
  "properties": {
    "mode": { "$ref": "common.schema.json#/$defs/mode" },
    "answers": {
      "$ref": "common.schema.json#/$defs/answerMap",
      "properties": {
        "user.agents": { "$ref": "common.schema.json#/$defs/agentSelection" },
        "tasks.mode": { "enum": ["local", "github", "both"] }
      }
    },
    "scopes": {
      "description": "Personal or team per setting (T-027), keyed by question id: a personal value is stored only in ~/.yaw/user-profile.yaml, a team value here.",
      "type": "object",
      "patternProperties": {
        "^(?!.*(secret|token|password|passwd|apikey|api-key|credential))(user|idea|domain|arch|delivery|quality|ui|privacy|backup|vendors|tasks|governance|team|compact)\\.[a-z][a-z0-9-]*$": { "enum": ["personal", "team"] }
      },
      "additionalProperties": false
    },
    "proposal": {
      "description": "Written by the PROPOSE step (/kickoff) for confirmation (doc 02 §1).",
      "type": "object",
      "required": ["status", "summary", "profiles", "modules"],
      "properties": {
        "status": { "enum": ["proposed", "confirmed"] },
        "summary": { "type": "string", "minLength": 1 },
        "profiles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" }, "minItems": 1, "uniqueItems": true },
        "modules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" }, "uniqueItems": true },
        "shape": { "type": "string", "minLength": 1 },
        "data": { "type": "string", "minLength": 1 },
        "hosting": { "type": "string", "minLength": 1 },
        "vendors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" }, "uniqueItems": true },
        "design": { "$ref": "common.schema.json#/$defs/name" },
        "rejected": {
          "description": "Rejected alternatives with a one-line reason.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
