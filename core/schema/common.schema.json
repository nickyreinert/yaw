{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "description": "Definitions used by several YAW schemas (ADR-0017).",
  "$defs": {
    "name": {
      "description": "Name of a module, profile, item, skill, subagent or gate.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "agentId": {
      "description": "Agents that can be selected in phase 1 (BD8).",
      "enum": ["claude", "codex", "copilot"]
    },
    "agentSelection": {
      "type": "array",
      "items": { "$ref": "#/$defs/agentId" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support": {
      "description": "native: feature exists; partial: works with limits (note shown); fallback: AGENTS.md rule or manual command; none: hidden, reason shown.",
      "enum": ["native", "partial", "fallback", "none"]
    },
    "agentCompat": {
      "type": "object",
      "required": ["support"],
      "properties": {
        "support": { "$ref": "#/$defs/support" },
        "via": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "agentsMap": {
      "description": "Compatibility attribute (doc 09 §3). Phase-3 agent keys are accepted so support can be recorded early.",
      "type": "object",
      "properties": {
        "claude": { "$ref": "#/$defs/agentCompat" },
        "codex": { "$ref": "#/$defs/agentCompat" },
        "copilot": { "$ref": "#/$defs/agentCompat" },
        "gemini": { "$ref": "#/$defs/agentCompat" },
        "antigravity": { "$ref": "#/$defs/agentCompat" },
        "pi": { "$ref": "#/$defs/agentCompat" },
        "hermes": { "$ref": "#/$defs/agentCompat" }
      },
      "additionalProperties": false
    },
    "tokenCost": {
      "description": "Model tokens added per turn.",
      "enum": ["none", "low", "medium"]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relPath": {
      "description": "Path relative to the project root; no leading slash, no backslash, no '..' segment.",
      "type": "string",
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[^\\\\]+$"
    },
    "mode": {
      "description": "Setup mode (doc 02 §2).",
      "enum": ["quick", "standard", "full"]
    },
    "questionId": {
      "description": "<group>.<name>; group is a doc 03 section name. Words that suggest secrets are not allowed.",
      "type": "string",
      "pattern": "^(?!.*(secret|token|password|passwd|apikey|api-key|credential))(user|idea|domain|arch|delivery|quality|ui|privacy|backup|vendors|tasks|governance|team)\\.[a-z][a-z0-9-]*$"
    },
    "answerValue": {
      "description": "An answer: a scalar or a list of scalars.",
      "type": ["string", "number", "boolean", "null", "array"],
      "items": { "type": ["string", "number", "boolean"] }
    },
    "answerMap": {
      "description": "Answers keyed by question id.",
      "type": "object",
      "patternProperties": {
        "^(?!.*(secret|token|password|passwd|apikey|api-key|credential))(user|idea|domain|arch|delivery|quality|ui|privacy|backup|vendors|tasks|governance|team)\\.[a-z][a-z0-9-]*$": { "$ref": "#/$defs/answerValue" }
      },
      "additionalProperties": false
    },
    "boolFact": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "array", "items": { "type": "boolean" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+#-]*$"
    },
    "runsOn": {
      "enum": ["local", "self-hosted", "docker", "serverless", "edge", "app-store"]
    },
    "facts": {
      "description": "Derived facts vocabulary (ADR-0017). All listed keys must match; a list means any of its values.",
      "type": "object",
      "properties": {
        "hasUI": { "$ref": "#/$defs/boolFact" },
        "language": {
          "anyOf": [
            { "$ref": "#/$defs/language" },
            { "type": "array", "items": { "$ref": "#/$defs/language" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "runsOn": {
          "anyOf": [
            { "$ref": "#/$defs/runsOn" },
            { "type": "array", "items": { "$ref": "#/$defs/runsOn" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "public": { "$ref": "#/$defs/boolFact" },
        "storesData": { "$ref": "#/$defs/boolFact" },
        "hosted": { "$ref": "#/$defs/boolFact" },
        "team": { "$ref": "#/$defs/boolFact" },
        "usesGitHub": { "$ref": "#/$defs/boolFact" },
        "needsVendors": { "$ref": "#/$defs/boolFact" },
        "knowledgeStore": { "$ref": "#/$defs/boolFact" }
      },
      "additionalProperties": false
    },
    "presetDefault": {
      "description": "true/false, \"ask\", or a facts condition (preselected when the facts match).",
      "anyOf": [
        { "type": "boolean" },
        { "const": "ask" },
        { "$ref": "#/$defs/facts" }
      ]
    },
    "presetDefaults": {
      "type": "object",
      "required": ["quick", "standard", "full"],
      "properties": {
        "quick": { "$ref": "#/$defs/presetDefault" },
        "standard": { "$ref": "#/$defs/presetDefault" },
        "full": { "$ref": "#/$defs/presetDefault" }
      },
      "additionalProperties": false
    }
  }
}
